<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.2.xsd">

  <module name="quality" package="com.axelor.apps.quality.db"/>

  <entity name="ControlTypeField">

    <string name="name" title="Name" required="true"/>
    <string name="code" title="Code" required="true" unique="true"/>
    <integer name="typeSelect" title="Type" required="true"
      selection="quality.control.type.field.type.select"/>
    <many-to-many name="valueSet"
      ref="com.axelor.apps.quality.db.CharacteristicProperty" title="Allowed values"/>
    <boolean name="isRequired" title="Required"/>

    <extra-code>
			<![CDATA[
				public static final int TYPE_DECIMAL = 1;
				public static final int TYPE_TEXT = 2;
				public static final int TYPE_BOOLEAN = 3;
				public static final int TYPE_SELECTION = 4;

			]]>
    </extra-code>
  </entity>

</domain-models>
