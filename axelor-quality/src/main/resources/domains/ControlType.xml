<?xml version="1.0" ?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.2.xsd">

  <module name="quality" package="com.axelor.apps.quality.db"/>

  <entity name="ControlType">
    <string name="name" title="Name"/>

    <string name="conformityFormula" title="Formula" large="true"/>
    <string name="formulaDescription" title="Formula description" large="true"/>

    <many-to-many name="controlTypeFieldSet"
      ref="com.axelor.apps.quality.db.ControlTypeField" title="Fields"
      orderBy="usageSelect,sequence,name"/>

  </entity>

</domain-models>
