<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <grid name="control-plan-line-grid" title="Control plan lines"
    model="com.axelor.apps.quality.db.ControlEntryPlanLine" canEdit="false">
    <field name="name"/>
    <field name="priority"/>
    <field name="reference"/>
    <field name="typeSelect"/>
    <field name="characteristic"/>
    <field name="isCustomFrequency" hidden="true"/>
  </grid>

  <form name="control-plan-line-form" title="Control plan line"
    model="com.axelor.apps.quality.db.ControlEntryPlanLine"
    onNew="action-quality-control-plan-line-record-default">
    <panel name="mainPanel" colSpan="12">
      <field name="priority" colSpan="3"/>
      <field name="controlType" colSpan="3" required="true"
        onChange="action-quality-control-plan-line-method-sync-plan-values"/>
      <field name="characteristic" colSpan="6"/>
      <field name="name" required="true" colSpan="6"/>
      <field name="isCustomFrequency" colSpan="3" hidden="true"/>
      <field name="controlPlanFrequency" colSpan="9" showIf="isCustomFrequency" hidden="true"/>
      <field name="description" widget="html" colSpan="12"/>
    </panel>

    <panel name="planValuePanel" title="Control type configuration" showIf="controlType"
      colSpan="12">
      <field name="controlType.formulaDescription" hidden="true"/>
      <field name="$formulaDescriptionViewer" showTitle="false" readonly="true" colSpan="12"
        showIf="controlType.formulaDescription">
        <viewer><![CDATA[
			<>
				<Alert variant="info" mb={0} p={2}>
					<span style={{whiteSpace: 'pre-line'}}>{controlType && controlType.formulaDescription}</span>
				</Alert>
			</>
		  ]]></viewer>
      </field>
      <button name="syncPlanValuesBtn" title="Refresh fields" colSpan="12"
        onClick="action-quality-control-plan-line-method-sync-plan-values"
        help="Adds the fields added to the control type since this line was created and removes the ones no longer configured. The values already entered are kept."/>
      <field name="planValueList" showTitle="false" colSpan="12" canNew="false"
        canRemove="false" grid-view="control-type-field-value-grid"
        form-view="control-type-field-value-form">
        <editor x-show-titles="false" x-viewer="true">
          <field name="controlTypeField" readonly="true" canEdit="false" canView="false"/>
          <panel name="valuePanel" stacked="true" showTitle="false" itemSpan="12">
            <field name="fieldTypeSelect" hidden="true"/>
            <field name="decimalValue" title="Value" x-scale="3" showIf="fieldTypeSelect == 1"/>
            <field name="textValue" title="Value" showIf="fieldTypeSelect == 2"/>
            <field name="booleanValue" title="Value" showIf="fieldTypeSelect == 3"/>
            <field name="selectionValue" title="Value" canNew="false"
              showIf="fieldTypeSelect == 4"
              onSelect="action-quality-control-type-field-value-attrs-selection-domain"/>
          </panel>
        </editor>
      </field>
    </panel>
  </form>

  <grid name="control-entry-sample-line-grid" title="Control entry sample lines"
    model="com.axelor.apps.quality.db.ControlEntryPlanLine">
    <field name="controlPlanLine"/>
    <field name="resultSelect"/>
  </grid>

  <form name="control-entry-sample-line-form" title="Control entry sample line"
    model="com.axelor.apps.quality.db.ControlEntryPlanLine"
    onNew="action-quality-control-entry-line-record-default,action-quality-record-control-entry-line-load-control-plan-parent"
    onLoad="action-quality-record-control-entry-line-load-control-plan-parent">
    <panel name="mainPanel" colSpan="12">
      <field name="controlPlanLine" colSpan="6" form-view="control-plan-line-form"
        grid-view="control-plan-line-grid"
        domain="self.typeSelect = 1 AND self.controlPlan = :controlPlanParent"
        onChange="action-quality-control-entry-line-copy-record" required="true" readonly="true"/>
      <field name="controlPlanLine.characteristic" colSpan="6"/>
      <field name="controlType" readonly="true"/>
      <field name="resultSelect" colSpan="6" readonly="true"/>
      <field name="controlEntrySample" colSpan="6" readonly="true"/>
      <field name="$controlPlanParent" type="many-to-one"
        target="com.axelor.apps.quality.db.ControlPlan" hidden="true"/>
    </panel>

    <panel name="descriptionPanel" showTitle="false" showIf="controlPlanLine" colSpan="12">
      <field name="controlType.formulaDescription" hidden="true"/>
      <field name="$formulaDescriptionViewer" showTitle="false" readonly="true" colSpan="12"
        showIf="controlType.formulaDescription">
        <viewer><![CDATA[
			<>
				<Alert variant="info" mb={0} p={2}>
					<span style={{whiteSpace: 'pre-line'}}>{controlType && controlType.formulaDescription}</span>
				</Alert>
			</>
		  ]]></viewer>
      </field>
    </panel>

    <panel-tabs name="controlValueTabsPanel" showIf="controlPlanLine">
      <panel name="entryValuePanel" title="Measures">
        <field name="entryValueList" showTitle="false" colSpan="12" canNew="false"
          canRemove="false" grid-view="control-type-field-value-grid"
          form-view="control-type-field-value-form">
          <editor x-show-titles="false" x-viewer="true">
            <field name="controlTypeField" readonly="true" canEdit="false" canView="false"/>
            <panel name="valuePanel" stacked="true" showTitle="false" itemSpan="12">
              <field name="fieldTypeSelect" hidden="true"/>
              <field name="decimalValue" title="Value" x-scale="3"
                showIf="fieldTypeSelect == 1"/>
              <field name="textValue" title="Value" showIf="fieldTypeSelect == 2"/>
              <field name="booleanValue" title="Value" showIf="fieldTypeSelect == 3"/>
              <field name="selectionValue" title="Value" canNew="false"
                showIf="fieldTypeSelect == 4"
                onSelect="action-quality-control-type-field-value-attrs-selection-domain"/>
            </panel>
          </editor>
        </field>
      </panel>

      <panel name="targetPanel" title="Targets">
        <panel-dashlet name="planValueDashlet" showTitle="false" colSpan="12"
          height="200%" canSearch="true"
          action="action-quality-control-type-field-value-view-plan-values"/>
      </panel>
    </panel-tabs>

    <panel name="conformityPanel" showTitle="false" showIf="controlPlanLine" colSpan="12">
      <button name="checkConformityBtn" title="Check conformity"
        onClick="save,action-quality-control-entry-line-method-control-conformity"/>
    </panel>

  </form>


  <action-record
    name="action-quality-record-control-entry-line-load-control-plan-parent"
    model="com.axelor.apps.quality.db.ControlEntryPlanLine">
    <field name="$controlPlanParent" expr="eval: __parent__?.parentContext?.controlPlan"/>
  </action-record>

  <action-record name="action-quality-control-plan-line-record-default"
    model="com.axelor.apps.quality.db.ControlEntryPlanLine">
    <field name="typeSelect" expr="eval: 1"/>
  </action-record>

  <action-record name="action-quality-control-entry-line-record-default"
    model="com.axelor.apps.quality.db.ControlEntryPlanLine">
    <field name="typeSelect" expr="eval: 2"/>
    <field name="resultSelect" expr="eval: 1"/>
  </action-record>

  <action-record name="action-quality-control-entry-line-copy-record"
    model="com.axelor.apps.quality.db.ControlEntryPlanLine">
    <field name="controlType" expr="eval: controlPlanLine?.controlType"/>
  </action-record>

  <action-method name="action-quality-control-plan-line-method-sync-plan-values">
    <call class="com.axelor.apps.quality.web.ControlEntryPlanLineController"
      method="syncPlanValues"/>
  </action-method>

  <action-method name="action-quality-control-entry-line-method-control-conformity">
    <call class="com.axelor.apps.quality.web.ControlEntryPlanLineController"
      method="controlConformity"/>
  </action-method>


</object-views>
