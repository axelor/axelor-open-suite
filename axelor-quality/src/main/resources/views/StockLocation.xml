<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <form id="quality-stock-location-form" name="stock-location-form" title="Stock location"
    model="com.axelor.apps.stock.db.StockLocation" extension="true">

    <extend target="//panel[@name='configPanel']">
      <insert position="inside">
        <field name="quarantineStockLocation" colSpan="3" canEdit="false"
          if="__config__.app.isApp('quality')" showIf="typeSelect == 1"
          domain="self.company = :company AND self.typeSelect = 1 AND (:id IS NULL OR self.id != :id)"
          form-view="stock-location-form" grid-view="stock-location-grid"/>
      </insert>
    </extend>

  </form>

</object-views>
