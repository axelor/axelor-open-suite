<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <grid name="supplier-score-history-grid" id="quality-supplier-score-history-grid"
    title="Supplier score history" model="com.axelor.apps.supplychain.db.SupplierScoreHistory"
    extension="true">
    <extend target="//field[@name='supplierAssessedReceptionCount']">
      <insert position="after">
        <field name="supplierOpenQiRate" x-scale="2" if="__config__.app.isApp('quality')"/>
      </insert>
    </extend>
  </grid>

  <form name="supplier-score-history-form" id="quality-supplier-score-history-form"
    title="Supplier score history" model="com.axelor.apps.supplychain.db.SupplierScoreHistory"
    extension="true">
    <extend target="//field[@name='supplierAssessedReceptionCount']">
      <insert position="after">
        <field name="supplierOpenQiRate" x-scale="2" if="__config__.app.isApp('quality')"/>
      </insert>
    </extend>
  </form>

</object-views>
