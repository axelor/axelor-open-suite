<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <form name="app-supplychain-config-form" title="App Supplychain"
    model="com.axelor.studio.db.AppSupplychain" canDelete="false" canNew="false" width="large"
    id="quality-app-supplychain-config-form" extension="true">

    <extend target="//field[@name='supplierScoreConformityWeight']">
      <insert position="after">
        <field name="supplierScoreQiWeight" colSpan="4" if="__config__.app.isApp('quality')"/>
        <field name="supplierScoreNonConformityWeight" colSpan="4"
          if="__config__.app.isApp('quality')"/>
      </insert>
    </extend>

    <extend target="//panel[@name='supplierScoreWeightsPanel']">
      <insert position="after">
        <panel name="supplierScoreGravityWeightsPanel" title="Gravity weights" colSpan="12"
          showIf="manageSupplierScore" if="__config__.app.isApp('quality')">
          <field name="supplierScoreGravityCriticalWeight" colSpan="4"/>
          <field name="supplierScoreGravityMajorWeight" colSpan="4"/>
          <field name="supplierScoreGravityMinorWeight" colSpan="4"/>
        </panel>
        <panel name="supplierQualityTrendPanel" title="Quality trend" colSpan="12"
          showIf="manageSupplierScore" if="__config__.app.isApp('quality')">
          <field name="supplierQualityTrendMonths" colSpan="4"/>
          <field name="supplierQualityTrendTolerance" colSpan="4"/>
        </panel>
      </insert>
    </extend>

    <extend target="//field[@name='autoComputeSupplierConformityRate']">
      <insert position="after">
        <field name="autoComputeSupplierOpenQiRate" widget="boolean-switch" colSpan="4"
          if="__config__.app.isApp('quality')"/>
        <field name="autoComputeSupplierNonConformityRate" widget="boolean-switch" colSpan="4"
          if="__config__.app.isApp('quality')"/>
      </insert>
    </extend>

  </form>

</object-views>
