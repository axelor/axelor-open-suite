<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <form name="supplier-dispute-form" id="contract-supplier-dispute-form"
    title="Supplier dispute" model="com.axelor.apps.supplychain.db.SupplierDispute" extension="true">
    <extend target="//field[@name='purchaseOrder']">
      <insert position="after">
        <field name="contract" canEdit="false" if="__config__.app.isApp('contract')"
          domain="self.partner = :supplierPartner AND self.company = :company AND self.targetTypeSelect = 2"
          form-view="contract-form" grid-view="contract-grid"/>
      </insert>
    </extend>
  </form>

  <action-record name="action-contract-supplier-dispute-record-prefill"
    model="com.axelor.apps.supplychain.db.SupplierDispute">
    <field name="contract" expr="eval: __repo__(Contract).find(_contractId)"
      if="_contractId != null"/>
  </action-record>

  <action-view name="action-contract-view-supplier-disputes" title="Supplier disputes"
    model="com.axelor.apps.supplychain.db.SupplierDispute">
    <view type="grid" name="supplier-dispute-grid"/>
    <view type="form" name="supplier-dispute-form"/>
    <domain>self.contract.id = :_contractId</domain>
    <context name="_contractId" expr="eval: id"/>
  </action-view>

  <action-view name="action-contract-view-create-supplier-dispute"
    title="Supplier dispute" model="com.axelor.apps.supplychain.db.SupplierDispute">
    <view type="form" name="supplier-dispute-form"/>
    <context name="_contractId" expr="eval: id"/>
    <context name="_supplierPartnerId" expr="eval: partner?.id"/>
  </action-view>

</object-views>
