<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <form name="invoice-line-form" title="Invoice line"
    model="com.axelor.apps.account.db.InvoiceLine" id="contract-invoice-line-form" extension="true">
    <extend target="//field[@name='isShowTotal']">
      <attribute name="if"
        value="__config__.app.getApp('sale')?.enablePackManagement || __config__.app.getApp('contract')?.isPackManagement"/>
    </extend>
    <extend target="//field[@name='isHideUnitAmounts']">
      <attribute name="if"
        value="__config__.app.getApp('sale')?.enablePackManagement || __config__.app.getApp('contract')?.isPackManagement"/>
    </extend>
  </form>

</object-views>
