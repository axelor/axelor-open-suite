<?xml version="1.0" encoding="UTF-8"?>
<domain-models xmlns="http://axelor.com/xml/ns/domain-models"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/domain-models https://axelor.com/xml/ns/domain-models/domain-models_8.2.xsd">

  <module name="supplychain" package="com.axelor.apps.supplychain.db"/>

  <entity name="ProductMergeLog">

    <many-to-one name="keptProduct" ref="com.axelor.apps.base.db.Product"
      title="Kept product" required="true"/>
    <many-to-one name="absorbedProduct" ref="com.axelor.apps.base.db.Product"
      title="Absorbed product" required="true"/>
    <datetime name="mergeDateTime" title="Merge date" required="true"/>
    <many-to-one name="user" column="user_id" ref="com.axelor.auth.db.User" title="User"
      required="true"/>
    <string name="log" title="Log" large="true"/>

  </entity>

</domain-models>
