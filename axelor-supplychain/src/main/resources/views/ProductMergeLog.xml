<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <grid name="product-merge-log-grid" title="Product merge logs"
    model="com.axelor.apps.supplychain.db.ProductMergeLog" orderBy="-mergeDateTime" canNew="false"
    canEdit="false" canDelete="false">
    <field name="mergeDateTime"/>
    <field name="absorbedProduct" form-view="product-form" grid-view="product-grid"/>
    <field name="keptProduct" form-view="product-form" grid-view="product-grid"/>
    <field name="user" form-view="user-form" grid-view="user-grid"/>
  </grid>

  <form name="product-merge-log-form" title="Product merge log"
    model="com.axelor.apps.supplychain.db.ProductMergeLog" canNew="false" canSave="false"
    canCopy="false" canDelete="false">
    <panel name="mainPanel">
      <field name="absorbedProduct" form-view="product-form" grid-view="product-grid"
        canNew="false" canEdit="false" readonly="true"/>
      <field name="keptProduct" form-view="product-form" grid-view="product-grid"
        canNew="false" canEdit="false" readonly="true"/>
      <field name="mergeDateTime" readonly="true"/>
      <field name="user" form-view="user-form" grid-view="user-grid" canNew="false"
        canEdit="false" canView="false" readonly="true"/>
    </panel>
    <panel name="logPanel" title="Log">
      <field name="log" showTitle="false" colSpan="12" readonly="true"/>
    </panel>
  </form>

</object-views>
