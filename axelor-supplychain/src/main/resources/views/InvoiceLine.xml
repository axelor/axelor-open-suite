<?xml version="1.0" encoding="UTF-8"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <form id="supplychain-invoice-line-form" name="invoice-line-form" title="Invoice line"
    model="com.axelor.apps.account.db.InvoiceLine" extension="true">
    <extend target="//panel[@name='customerInvoicePanel']/field[@name='typeSelect']">
      <insert position="after">
        <field name="customerCatalog" colSpan="3" target-name="productCustomerCode"
          readonly="true" showIf="customerCatalog" form-view="customer-catalog-partner-form"
          grid-view="customer-catalog-partner-grid"
          if="__config__.app.getApp('sale')?.getEnableCustomerCatalogMgt()"/>
      </insert>
    </extend>
    <extend target="//panel-tabs[@name='mainPanelTab']">
      <insert position="after">
        <panel-related name="subInvoiceLinesPanel" field="subLineList"
          title="Sub invoice lines"
          showIf="id &amp;&amp; subLineList &amp;&amp; subLineList.length > 0" colSpan="12"
          canNew="false" canEdit="false" canDelete="false" editable="false">
          <field name="productName" readonly="true"/>
          <field name="qty" readonly="true" x-scale="$nbDecimalDigitForQty"/>
          <field name="unit" readonly="true"/>
          <field name="exTaxTotal" readonly="true"/>
        </panel-related>
      </insert>
    </extend>
  </form>

</object-views>
