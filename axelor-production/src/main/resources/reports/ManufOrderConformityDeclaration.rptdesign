        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ManufOrderDS" id="144">
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace('@INJECTID', params["ManufOrderId"])]]></method>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">id</property>
                    <property name="nativeName">id</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">manuf_order_seq</property>
                    <property name="nativeName">manuf_order_seq</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">real_start_datet</property>
                    <property name="nativeName">real_start_datet</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">real_end_datet</property>
                    <property name="nativeName">real_end_datet</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">product_code</property>
                    <property name="nativeName">product_code</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">product_name</property>
                    <property name="nativeName">product_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">7</property>
                    <property name="name">produced_qty</property>
                    <property name="nativeName">produced_qty</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">8</property>
                    <property name="name">unit_code</property>
                    <property name="nativeName">unit_code</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">9</property>
                    <property name="name">company_name</property>
                    <property name="nativeName">company_name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">10</property>
                    <property name="name">company_address</property>
                    <property name="nativeName">company_address</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">11</property>
                    <property name="name">logo_id</property>
                    <property name="nativeName">logo_id</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">12</property>
                    <property name="name">logo_height</property>
                    <property name="nativeName">logo_height</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">13</property>
                    <property name="name">logo_width</property>
                    <property name="nativeName">logo_width</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">14</property>
                    <property name="name">sale_orders</property>
                    <property name="nativeName">sale_orders</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
ManufOrder.id,
ManufOrder.manuf_order_seq,
ManufOrder.real_start_datet,
ManufOrder.real_end_datet,
Product.code AS product_code,
Product.name AS product_name,
COALESCE(Produced.qty, 0) AS produced_qty,
Unit.label_to_printing AS unit_code,
Company.name AS company_name,
Address.full_name AS company_address,
MetaFile.id AS logo_id,
Company.height AS logo_height,
Company.width AS logo_width,
STRING_AGG(DISTINCT SaleOrder.sale_order_seq, ', ') AS sale_orders
FROM production_manuf_order AS ManufOrder
LEFT JOIN base_company AS Company ON (Company.id = ManufOrder.company)
LEFT JOIN base_address AS Address ON (Address.id = Company.address)
LEFT JOIN meta_file AS MetaFile ON (MetaFile.id = Company.logo)
LEFT JOIN base_product AS Product ON (Product.id = ManufOrder.product)
LEFT JOIN base_unit AS Unit ON (Unit.id = ManufOrder.unit)
LEFT JOIN (
  SELECT Line.produced_manuf_order AS manuf_order, SUM(Line.real_qty) AS qty
  FROM stock_stock_move_line AS Line
  JOIN stock_stock_move AS Move ON (Move.id = Line.stock_move)
  JOIN production_manuf_order AS ProducedManufOrder ON (ProducedManufOrder.id = Line.produced_manuf_order)
  WHERE Move.status_select = 3 AND Line.product = ProducedManufOrder.product
  GROUP BY Line.produced_manuf_order
) AS Produced ON (Produced.manuf_order = ManufOrder.id)
LEFT JOIN production_manuf_order_sale_order_set AS SaleOrderSet ON (SaleOrderSet.production_manuf_order = ManufOrder.id)
LEFT JOIN sale_sale_order AS SaleOrder ON (SaleOrder.id = SaleOrderSet.sale_order_set)
WHERE ManufOrder.id IN (@INJECTID)
GROUP BY ManufOrder.id,
ManufOrder.manuf_order_seq,
ManufOrder.real_start_datet,
ManufOrder.real_end_datet,
Product.code,
Product.name,
Produced.qty,
Unit.label_to_printing,
Company.name,
Address.full_name,
MetaFile.id,
Company.height,
Company.width]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ControlEntryDS" id="145">
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace('@INJECTID', params["ManufOrderId"])]]></method>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">id</property>
                    <property name="nativeName">id</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">name</property>
                    <property name="nativeName">name</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">entry_date_time</property>
                    <property name="nativeName">entry_date_time</property>
                    <property name="dataType">date-time</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">inspector</property>
                    <property name="nativeName">inspector</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">control_plan</property>
                    <property name="nativeName">control_plan</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">tracking_numbers</property>
                    <property name="nativeName">tracking_numbers</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[WITH ProducedLot AS (
  SELECT DISTINCT Line.tracking_number AS id
  FROM stock_stock_move_line AS Line
  JOIN stock_stock_move AS Move ON (Move.id = Line.stock_move)
  WHERE Line.produced_manuf_order IN (@INJECTID)
    AND Move.status_select != 4
    AND Line.tracking_number IS NOT NULL
),
FinalEntry AS (
  SELECT Entry.*
  FROM quality_control_entry AS Entry
  JOIN quality_control_plan AS Plan ON (Plan.id = Entry.control_plan)
  JOIN production_manuf_order AS ManufOrder ON (ManufOrder.id IN (@INJECTID))
  WHERE Entry.status_select = 3
    AND Plan.related_to_select = 'com.axelor.apps.base.db.Product'
    AND Plan.related_to_select_id = ManufOrder.product
    AND ((Entry.related_to_select = 'com.axelor.apps.production.db.ManufOrder' AND Entry.related_to_select_id = ManufOrder.id)
      OR (Entry.related_to_select = 'com.axelor.apps.stock.db.TrackingNumber' AND Entry.related_to_select_id IN (SELECT id FROM ProducedLot)))
    AND EXISTS (SELECT 1 FROM quality_control_entry_sample AS Sample WHERE Sample.control_entry = Entry.id)
    AND NOT EXISTS (SELECT 1 FROM quality_control_entry_sample AS Sample WHERE Sample.control_entry = Entry.id AND Sample.result_select != 2)
)
SELECT
FinalEntry.id,
FinalEntry.name,
FinalEntry.entry_date_time,
Inspector.full_name AS inspector,
CONCAT(Plan.code, ' - ', Plan.name) AS control_plan,
CASE WHEN FinalEntry.related_to_select = 'com.axelor.apps.stock.db.TrackingNumber' THEN LotTrackingNumber.tracking_number_seq
  ELSE (SELECT STRING_AGG(TrackingNumber.tracking_number_seq, ', ' ORDER BY TrackingNumber.tracking_number_seq)
        FROM ProducedLot JOIN stock_tracking_number AS TrackingNumber ON (TrackingNumber.id = ProducedLot.id))
END AS tracking_numbers
FROM FinalEntry
JOIN quality_control_plan AS Plan ON (Plan.id = FinalEntry.control_plan)
LEFT JOIN auth_user AS Inspector ON (Inspector.id = FinalEntry.inspector)
LEFT JOIN stock_tracking_number AS LotTrackingNumber ON (LotTrackingNumber.id = FinalEntry.related_to_select_id
  AND FinalEntry.related_to_select = 'com.axelor.apps.stock.db.TrackingNumber')
ORDER BY FinalEntry.entry_date_time, FinalEntry.id]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="CharacteristicDS" id="146">
            <method name="beforeOpen"><![CDATA[this.queryText = this.queryText.replace('@INJECTID', params["ManufOrderId"])]]></method>
            <property name="dataSource">Data Source</property>
            <list-property name="resultSet">
                <structure>
                    <property name="position">1</property>
                    <property name="name">control_entry_id</property>
                    <property name="nativeName">control_entry_id</property>
                    <property name="dataType">decimal</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">sample</property>
                    <property name="nativeName">sample</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">characteristic</property>
                    <property name="nativeName">characteristic</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">reference_values</property>
                    <property name="nativeName">reference_values</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">measured_values</property>
                    <property name="nativeName">measured_values</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[WITH ProducedLot AS (
  SELECT DISTINCT Line.tracking_number AS id
  FROM stock_stock_move_line AS Line
  JOIN stock_stock_move AS Move ON (Move.id = Line.stock_move)
  WHERE Line.produced_manuf_order IN (@INJECTID)
    AND Move.status_select != 4
    AND Line.tracking_number IS NOT NULL
),
FinalEntry AS (
  SELECT Entry.*
  FROM quality_control_entry AS Entry
  JOIN quality_control_plan AS Plan ON (Plan.id = Entry.control_plan)
  JOIN production_manuf_order AS ManufOrder ON (ManufOrder.id IN (@INJECTID))
  WHERE Entry.status_select = 3
    AND Plan.related_to_select = 'com.axelor.apps.base.db.Product'
    AND Plan.related_to_select_id = ManufOrder.product
    AND ((Entry.related_to_select = 'com.axelor.apps.production.db.ManufOrder' AND Entry.related_to_select_id = ManufOrder.id)
      OR (Entry.related_to_select = 'com.axelor.apps.stock.db.TrackingNumber' AND Entry.related_to_select_id IN (SELECT id FROM ProducedLot)))
    AND EXISTS (SELECT 1 FROM quality_control_entry_sample AS Sample WHERE Sample.control_entry = Entry.id)
    AND NOT EXISTS (SELECT 1 FROM quality_control_entry_sample AS Sample WHERE Sample.control_entry = Entry.id AND Sample.result_select != 2)
)
SELECT
Sample.control_entry AS control_entry_id,
CONCAT_WS(' ', Sample.entry_sample_ref, Sample.entry_sample_nbr) AS sample,
COALESCE(Characteristic.name, Line.name) AS characteristic,
(SELECT STRING_AGG(PlanValue.display_value, ' / ' ORDER BY PlanValue.sequence)
 FROM quality_control_type_field_value AS PlanValue WHERE PlanValue.plan_line = Line.control_plan_line) AS reference_values,
(SELECT STRING_AGG(EntryValue.display_value, ' / ' ORDER BY EntryValue.sequence)
 FROM quality_control_type_field_value AS EntryValue WHERE EntryValue.entry_line = Line.id) AS measured_values
FROM quality_control_entry_plan_line AS Line
JOIN quality_control_entry_sample AS Sample ON (Sample.id = Line.control_entry_sample)
JOIN FinalEntry ON (FinalEntry.id = Sample.control_entry)
LEFT JOIN quality_control_plan_line_characteristic AS Characteristic ON (Characteristic.id = Line.characteristic)
WHERE Line.type_select = 2
ORDER BY Sample.control_entry, Sample.entry_sample_nbr, Line.priority, Line.id]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="TranslateDS" id="3">
            <list-property name="parameters">
                <structure>
                    <property name="name">param_1</property>
                    <property name="nativeName"/>
                    <property name="dataType">string</property>
