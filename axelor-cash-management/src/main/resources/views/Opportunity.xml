<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<object-views xmlns="http://axelor.com/xml/ns/object-views"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://axelor.com/xml/ns/object-views https://axelor.com/xml/ns/object-views/object-views_8.2.xsd">

  <form id="cash-management-opportunity-form" name="opportunity-form" title="Opportunity"
    model="com.axelor.apps.crm.db.Opportunity" extension="true">
    <extend target="/">
      <attribute name="onNew" value="cash-management-action-opportunity-group-new"/>
    </extend>
    <extend target="//field[@name='company']">
      <attribute name="onChange" value="action-opportunity-method-fill-bank-details"/>
    </extend>
    <extend target="//field[@name='partner']">
      <attribute name="onChange" value="action-opportunity-group-partner-onchange"/>
    </extend>
    <extend target="//field[@name='contact']">
      <attribute name="onChange" value="action-opportunity-group-contact-onchange"/>
    </extend>
  </form>

  <action-group name="cash-management-action-opportunity-group-new">
    <action name="action-opportunity-group-new"/>
    <action name="action-opportunity-method-fill-bank-details"/>
  </action-group>

  <action-group name="action-opportunity-group-partner-onchange">
    <action name="action-opportunity-record-set-contact"/>
    <action name="action-opportunity-method-fill-bank-details"/>
  </action-group>

  <action-group name="action-opportunity-group-contact-onchange">
    <action name="action-opportunity-record-set-partner"/>
    <action name="action-opportunity-method-fill-bank-details"/>
  </action-group>

  <action-method name="action-opportunity-method-fill-bank-details">
    <call class="com.axelor.apps.cash.management.web.OpportunityController"
      method="fillBankDetails"/>
  </action-method>

</object-views>
